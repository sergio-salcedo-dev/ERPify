{
  "mcpServers": {
    "postman": {
      "command": "npx",
      "args": [
        "-y",
        "@postman/postman-mcp-server@latest",
        "--code"
      ],
      "env": {
        "POSTMAN_API_KEY": "${POSTMAN_API_KEY}"
      }
    },
    "sonarqube": {
      "command": "sonar",
      "args": [
        "run",
        "mcp",
        "--project",
        "sergio-salcedo-dev_ERPify"
      ]
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    }
  }
}
