# dotenv-linter:off UnorderedKey
#
# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

#XDEBUG_MODE=develop,debug
XDEBUG_MODE=off
PHP_IDE_SERVER_NAME=dev

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://erpify_user:erpify_password@database:5432/erpify_db?serverVersion=18&charset=utf8&connect_timeout=5"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000,https://localhost,https://127.0.0.1
###< nelmio/cors-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=noreply@erpify.local
# Security emails (invitation, reset, password-changed): monitored, replyable mailbox — never no-reply.
MAILER_SECURITY_FROM=seguridad@erpify.local
###< symfony/mailer ###

###> erpify/domain-events ###
DEFAULT_NOTIFICATION_EMAIL=sergio.salcedo.dev@gmail.com
###< erpify/domain-events ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# Docker Compose overrides these on the php service (see repo root compose.yaml).
# Full secret generation + production checklist: docs/mercure-production-deployment.md
# The URL Symfony uses to publish (often internal, e.g. http://php/.well-known/mercure).
MERCURE_URL=http://localhost/.well-known/mercure
# Browser-facing hub URL (FrankenPHP/Caddy on the same host as the PWA in the default stack).
MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
# MERCURE_JWT_SECRET: shared HMAC key so Symfony can sign publisher/subscriber JWTs the hub trusts.
# Generate a NEW random value for each environment (never reuse dev in prod):
#   openssl rand -hex 32
# Set the SAME value as Caddy/Compose CADDY_MERCURE_JWT_SECRET (publisher/subscriber keys).
# Do not commit real production values; use a secret manager or CI-injected env only.
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!
###< symfony/mercure-bundle ###

###> symfony/rate-limiter ###
# Per-IP sliding-window budget enforced on /api/* by RateLimitListener.
# Lower these on the fly (and bounce the worker) to tighten the budget under
# attack; raise them to give legitimate batch clients more headroom. Override
# per environment in .env.<env> (see .env.test for the deterministic 5/min
# used by functional tests).
RATE_LIMIT_ANONYMOUS_API_LIMIT=120
RATE_LIMIT_ANONYMOUS_API_INTERVAL='1 minute'
# Per-email forgot-password budget: exhaustion silences the work but the response stays the uniform 202.
RATE_LIMIT_PASSWORD_RECOVERY_PER_EMAIL_LIMIT=5
RATE_LIMIT_PASSWORD_RECOVERY_PER_EMAIL_INTERVAL='1 hour'
# Per-selector budget for token-consuming endpoints (reset/accept): exhaustion folds into the opaque wall.
RATE_LIMIT_TOKEN_ACTION_LIMIT=10
RATE_LIMIT_TOKEN_ACTION_INTERVAL='15 minutes'
# Per-identity budget on POST /me/password, mirroring the persisted lockout (10 attempts / 15 minutes).
# Exhaustion is a visible 429 — see the block comment in config/packages/rate_limiter.yaml.
RATE_LIMIT_PASSWORD_CHANGE_PER_IDENTITY_LIMIT=10
RATE_LIMIT_PASSWORD_CHANGE_PER_IDENTITY_INTERVAL='15 minutes'
###< symfony/rate-limiter ###

###> sentry/sentry-symfony ###
# Empty here so the SDK is inert. The bundle loads in dev + prod (not test).
# To watch your OWN errors while developing, set SENTRY_DSN in api/.env.local
# (gitignored) — events are tagged environment "dev". Prod (test machine + VPS)
# injects the real DSN via real env, never committed (provision via the Sentry
# MCP, .mcp.json).
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> erpify/sentry ###
# Performance tracing sample rate — PROD only (dev traces at a hardcoded 1.0 when
# a DSN is set in api/.env.local). The test machine and the VPS inject ~0.2; keep
# 0 as the default. The messenger:consume worker is excluded from tracing in
# sentry.yaml (see docs/deployment-guide.md).
SENTRY_TRACES_SAMPLE_RATE=0
###< erpify/sentry ###

###> erpify/crypto ###
# AUDIT_KEK: raw 32-byte key-encryption key (KEK) wrapping per-scope DEKs in the crypto-shredding keystore.
# Used verbatim as key material — must be exactly 32 bytes or boot fails. Generate: openssl rand -base64 24
# (32 chars). Custodied OUTSIDE the app in staging/prod (env / secret manager), never beside the DEKs. Dev
# placeholder below is a non-secret 32-byte literal (dev/CI shredding is not a real confidentiality boundary):
AUDIT_KEK=dev-audit-kek-not-a-secret-32byt
###< erpify/crypto ###
