# dotenv-linter:off UnorderedKey
#
# define your env variables for the test env here
KERNEL_CLASS="Erpify\Kernel"
APP_SECRET="$ecretf0rt3st"

# DATABASE_URL is deliberately absent. The stack injects it as a real container environment variable and
# Symfony's Dotenv never overwrites one that is already set, so a DSN written here binds nothing under
# Docker — it reads as an isolation guarantee while the process connects to whatever compose handed it.
# The dedicated test database comes from `dbname_suffix` in config/packages/doctrine.yaml, which is applied
# to the resolved connection and therefore holds no matter where DATABASE_URL comes from. Declaring one here
# again would also stack with that suffix (`..._test_test`) wherever this file does win.

MERCURE_URL="http://127.0.0.1/.well-known/mercure"
MERCURE_PUBLIC_URL="https://localhost/.well-known/mercure"
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"

# Lower the anonymous_api budget so functional tests can assert the 429 path
# deterministically without hammering the limiter 120+ times.
RATE_LIMIT_ANONYMOUS_API_LIMIT=5
RATE_LIMIT_ANONYMOUS_API_INTERVAL='1 minute'

# Null transport so notification emails never leave the process; RecordingMailerSubscriber still
# captures them off Symfony Mailer's MessageEvent for NotificationContext to assert.
MAILER_DSN=null://null

# Deterministic, non-personal recipient so NotificationContext can assert it without depending on the
# real operational address configured for dev/prod.
DEFAULT_NOTIFICATION_EMAIL=notifications@erpify.test
