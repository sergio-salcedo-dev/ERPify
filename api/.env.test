# dotenv-linter:off UnorderedKey
#
# define your env variables for the test env here
KERNEL_CLASS="Erpify\Kernel"
APP_SECRET="$ecretf0rt3st"

# Read this before adding a key: which lane a value in this file actually binds is NOT uniform. The stack
# exports many of these as real container environment variables, and the two bootstraps disagree about
# precedence — api/tests/Behat/bootstrap.php calls Dotenv::overload(), which overwrites an already-set
# variable, while api/tools/phpunit/bootstrap.php calls bootEnv(), which does not. So a key compose also
# exports binds Behat and is silently inert under PHPUnit. Force it in api/tools/phpunit/phpunit.dist.xml to
# bind both, as MERCURE_*, MAILER_DSN and DEFAULT_NOTIFICATION_EMAIL are.
#
# DATABASE_URL is deliberately absent, and is the reason the paragraph above is written down: a dedicated DSN
# sat here binding Behat while PHPUnit resolved the dev database and destroyed it. The test database now
# comes from `dbname_suffix` in config/packages/test/doctrine.yaml, applied to the resolved connection, so it
# binds both lanes however DATABASE_URL arrives. Declaring one here again would stack with that suffix
# (`..._test_test`) in the lane where this file does win. The same applies to an untracked .env.test.local.

MERCURE_URL="http://127.0.0.1/.well-known/mercure"
MERCURE_PUBLIC_URL="https://localhost/.well-known/mercure"
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"

# Lower the anonymous_api budget so functional tests can assert the 429 path
# deterministically without hammering the limiter 120+ times.
RATE_LIMIT_ANONYMOUS_API_LIMIT=5
RATE_LIMIT_ANONYMOUS_API_INTERVAL='1 minute'

# Null transport so notification emails never leave the process; RecordingMailerSubscriber still
# captures them off Symfony Mailer's MessageEvent for NotificationContext to assert.
MAILER_DSN=null://null

# Deterministic, non-personal recipient so NotificationContext can assert it without depending on the
# real operational address configured for dev/prod.
DEFAULT_NOTIFICATION_EMAIL=notifications@erpify.test
