{
    "name": "erpify/behat-tools",
    "description": "Isolated Behat runner that reuses the app autoload and Symfony kernel via friends-of-behat/symfony-extension.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "behat/behat": "^3.32.0",
        "friends-of-behat/symfony-extension": "^2.7.0",
        "symfony/browser-kit": "8.0.*",
        "symfony/http-client": "8.0.*",
        "symfony/css-selector": "8.0.*",
        "symfony/dom-crawler": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/mime": "8.0.*"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Erpify\\Tests\\Behat\\": "../../tests/Behat/"
        }
    }
}
