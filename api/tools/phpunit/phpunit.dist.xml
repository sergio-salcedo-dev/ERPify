<?xml version="1.0" encoding="UTF-8"?>

<!-- Paths are relative to this file's directory (api/tools/phpunit/). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         failOnEmptyTestSuite="true"
         failOnPhpunitNotice="true"
         failOnRisky="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnPhpunitNotices="true"
         bootstrap="bootstrap.php"
         cacheDirectory="../../var/cache/phpunit"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="MERCURE_URL" value="http://127.0.0.1/.well-known/mercure" force="true" />
        <server name="MERCURE_PUBLIC_URL" value="https://localhost/.well-known/mercure" force="true" />
        <server name="MERCURE_JWT_SECRET" value="!ChangeThisMercureHubJWTSecretKey!" force="true" />

        <!-- Forced for the same reason the MERCURE_* trio above is: compose exports both as real container
             environment variables, and this lane loads .env.test through bootEnv, which never overwrites one
             that is already set. Without these the file's own values are inert here — a test would reach
             mailpit over SMTP rather than the null transport, and the "deterministic, non-personal"
             recipient .env.test declares would be the maintainer's real address from compose.yaml. -->
        <server name="MAILER_DSN" value="null://null" force="true" />
        <server name="DEFAULT_NOTIFICATION_EMAIL" value="notifications@erpify.test" force="true" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>../../tests</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="false"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>../../src</directory>
        </include>

        <deprecationTrigger>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <extensions>
        <bootstrap class="Erpify\Tests\Support\PHPUnit\ResetSystemClockExtension" />
    </extensions>
</phpunit>
