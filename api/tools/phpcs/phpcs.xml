<?xml version="1.0"?>
<ruleset name="Coding Standards"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
    <description>PHP_CodeSniffer configuration</description>

    <!-- Coding Standard -->
    <!-- Use PSR-12 Extended Coding Style Guide -->
    <rule ref="PSR12"/>

    <!-- Files and Directories -->
    <!-- Include directories to check -->
    <file>../../bin</file>
    <file>../../config</file>
    <file>../../features</file>
    <file>../../public</file>
    <file>../../src</file>
    <file>../../tests</file>
    <file>../../tools</file>

    <!-- Exclude directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!-- Rules Configuration -->
    <!-- Set line length limit to 120 characters (matching PHP CS Fixer and PHP Insights config) -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="160"/>
            <property name="ignoreComments" value="false"/>
        </properties>
    </rule>

    <!-- Allow short array syntax (PSR-12 compatible) -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

    <!-- Sniff Exclusions -->
    <!--
        Operator spacing is php-cs-fixer's axis, not this tool's, and keeping both makes the two contradict
        each other on one construct. `PSR12.Operators.OperatorSpacing` reads the `|` of a multi-catch
        (`catch (A|B $e)`) as a binary operator and demands spaces around it, while php-cs-fixer's
        `types_spaces` demands the compact form back — so `php.quality.dry-run`, which runs BOTH, is red
        whichever way the line is written. Measured, in both directions: `A|B` is phpcs 2 / cs-fixer 0, and
        `A | B` is phpcs 0 / cs-fixer 2.

        phpcs is the one that is wrong, and it is also the redundant one:
        - It contradicts itself. Every compact union type in a signature (`array|string|null $acceptFormat`)
          passes this same run untouched; only the catch spelling is refused, though the `|` means the same
          thing in both places.
        - php-cs-fixer already owns this rule and enforces it MORE strictly — `binary_operator_spaces` is
          configured to `single_space`, deliberately overriding @PSR12's `at_least_single_space`. Verified
          rather than assumed: a planted `$probe = 1+2;` puts `php.cs-fixer.dry-run` at exit 2.

        So excluding these two codes removes a contradiction and loses no enforcement. Only the
        missing-space codes go: whatever else the sniff reports is untouched.
    -->
    <rule ref="PSR12.Operators.OperatorSpacing">
        <exclude name="PSR12.Operators.OperatorSpacing.NoSpaceBefore"/>
        <exclude name="PSR12.Operators.OperatorSpacing.NoSpaceAfter"/>
    </rule>

    <!-- Allow newline immediately after `(` in multi-line control-structure conditions -->
    <rule ref="PEAR.ControlStructures.MultiLineCondition">
        <exclude name="PEAR.ControlStructures.MultiLineCondition.SpacingAfterOpenBrace"/>
        <exclude name="PEAR.ControlStructures.MultiLineCondition.StartWithBoolean"/>
    </rule>

    <!-- Report Configuration -->
    <!-- Show colors in output -->
    <arg name="colors"/>
    <arg name="basepath" value="../../"/>
    <arg name="cache" value="../../var/cache/.phpcs-cache"/>
    <arg name="extensions" value="php"/>
</ruleset>
