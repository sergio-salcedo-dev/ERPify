{
  "info": {
    "name": "ERPify API",
    "description": "ERPify HTTP API (Symfony 8 on FrankenPHP).\n\n**Development environment:** `base_url = https://localhost` (primary checkout, fixed ports 80/443). The dev TLS certificate is local: disable *SSL certificate verification* in Postman (Settings → General) or trust Caddy's local CA.\n\n- All responses are JSON; errors follow RFC 9457 (`application/problem+json`).\n- Routes live under `/api/v1` (frontoffice/shared) and `/api/v1/backoffice` (backoffice).\n- Folders mirror the bounded contexts under `api/src/` (Backoffice, Frontoffice, Shared).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://localhost",
      "type": "string",
      "description": "Base URL of the development stack (FrankenPHP, primary checkout)"
    }
  ],
  "item": [
    {
      "name": "Backoffice",
      "description": "Backoffice bounded contexts — prefix /api/v1/backoffice",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/backoffice/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "backoffice", "health"]
            },
            "description": "Liveness check for the backoffice context. Requires an authenticated session: it is not exempt from the firewall, and answers 401 Problem Details without one. Use the Frontoffice health request for an unauthenticated probe."
          },
          "response": []
        },
        {
          "name": "Database health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/backoffice/health/database",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "backoffice", "health", "database"]
            },
            "description": "Database reachability probe (SELECT 1). Requires an authenticated session. Returns data.status 'ok' when the database responds, 'error' otherwise; HTTP 200 either way — the status code reports whether the request could be decided, data.status reports what the probe found."
          },
          "response": []
        },
        {
          "name": "Banks",
          "description": "Banks context (Backoffice/Bank)",
          "item": [
            {
              "name": "Search banks",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{base_url}}/api/v1/backoffice/banks?page=1&limit=100&paginationMode=light",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "backoffice", "banks"],
                  "query": [
                    { "key": "page", "value": "1", "description": "Page (offset pagination)" },
                    { "key": "limit", "value": "100", "description": "Max 1000 (default 1000)" },
                    { "key": "paginationMode", "value": "light", "description": "light | detailed" },
                    { "key": "cursor", "value": "", "description": "Opaque cursor for cursor-based pagination (mutually exclusive with page)", "disabled": true },
                    { "key": "filters[0][field]", "value": "name", "description": "Generic filter: public field name (allow-listed for banks: name, id)", "disabled": true },
                    { "key": "filters[0][operator]", "value": "contains", "description": "eq | in | contains (strictly lowercase); id allows only eq/in", "disabled": true },
                    { "key": "filters[0][value]", "value": "banc", "description": "Scalar value for eq/contains (max 255 chars); for in use filters[0][value][] (repeatable, max 100 values). Max 20 filters, indexes contiguous from 0; effective wire limit is min(caps, max_input_vars=1000, URL length)", "disabled": true }
                  ]
                },
                "description": "Paginated bank search. Serialization groups: identifiable, timestamped, bank:search. Generic filters[N][field|operator|value] grammar documented in api/docs/adding-endpoints.md."
              },
              "response": []
            },
            {
              "name": "Get bank",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{base_url}}/api/v1/backoffice/banks/:id",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "backoffice", "banks", ":id"],
                  "variable": [{ "key": "id", "value": "", "description": "Bank UUID" }]
                },
                "description": "Bank detail by UUID. 404 (application/problem+json) when it does not exist."
              },
              "response": []
            },
            {
              "name": "Create bank",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test Bank\",\n  \"shortName\": \"TB\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/backoffice/banks",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "backoffice", "banks"]
                },
                "description": "Creates a bank. `name` ≤ 255 chars, `shortName` ≤ 50 chars; both required. 201 on creation, 400 with violations on validation failure. Accepts JSON or form."
              },
              "response": []
            },
            {
              "name": "Update bank",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Accept", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test Bank (renamed)\",\n  \"shortName\": \"TBR\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/backoffice/banks/:id",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "backoffice", "banks", ":id"],
                  "variable": [{ "key": "id", "value": "", "description": "Bank UUID" }]
                },
                "description": "Updates a bank. Same validation rules as the POST."
              },
              "response": []
            },
            {
              "name": "Delete bank",
              "request": {
                "method": "DELETE",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{base_url}}/api/v1/backoffice/banks/:id",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "backoffice", "banks", ":id"],
                  "variable": [{ "key": "id", "value": "", "description": "Bank UUID" }]
                },
                "description": "Deletes a bank by UUID (hard delete)."
              },
              "response": []
            },
            {
              "name": "Realtime authorize (Mercure cookie)",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{base_url}}/api/v1/backoffice/banks/realtime/authorize",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "backoffice", "banks", "realtime", "authorize"]
                },
                "description": "Returns 204 and sets the Mercure authorization cookie for the bank topics (collection + detail)."
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Frontoffice",
      "description": "Frontoffice bounded contexts — prefix /api/v1",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Liveness check for the frontoffice context, and the only health route outside the firewall — reachable with no session, which is what the deploy smoke test and the public /status page rely on."
          },
          "response": []
        },
        {
          "name": "Dev",
          "description": "Dev context (Frontoffice/Dev) — dev environment only",
          "item": [
            {
              "name": "FrankenPHP hot reload (dev only)",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{base_url}}/api/v1/dev/frankenphp-hot-reload",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "dev", "frankenphp-hot-reload"]
                },
                "description": "FrankenPHP hot-reload endpoint. Only available in dev."
              },
              "response": []
            }
          ]
        }
      ]
    }
  ]
}
