# Aligned with https://github.com/api-platform/api-platform/blob/main/api/frankenphp/Caddyfile
# Worker snippet: frankenphp/worker.Caddyfile (same layout as API Platform).
# @pwa also excludes /api* and /.well-known/mercure* for this monorepo.

{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}

		import worker.Caddyfile
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		# NOTE: this expands INSIDE the log block and ahead of `format filter` below, so a deployment
		# that sets it to another encoder (`format json`, a documented use) replaces the redaction
		# without touching this repository and without any gate noticing. The filter below is only as
		# strong as this variable being left alone.
		{$CADDY_SERVER_LOG_OPTIONS}
		# The query string is dropped WHOLE, and that is the mechanism rather than a stronger setting of
		# the old one. This log has no owner of erasure — no compose file declares a `logging:` driver, so it
		# is the default json-file driver with neither rotation nor TTL, and nothing in the GDPR erasure path
		# can reach it — so whatever lands here outlives the erasure the app confirmed to the subject. The
		# obligation that follows is RETENTION, and it is not answered by observing that whoever planted a
		# value already knew it: the harm is that we now hold a person's identifier and cannot erase it.
		#
		# What stood here was a name allowlist — one `replace` line per sensitive parameter, plus one per
		# filter index up to `SearchQuery::MAX_FILTERS`. Measured against the running stack by
		# `AccessLogQueryContainmentGateTest`, that shape contained exactly ONE of nine spellings of a value:
		# the scalar `filters[N][value]`. The `in` operator's own spelling (`filters[N][value][]` and
		# `filters[N][value][0]`), any index past the enumeration, a double-encoded key, and a plain
		# parameter name nobody had listed all reached this log in clear. A TENTH spelling — the delimiter
		# itself percent-encoded — was found afterwards by an adversarial read and falsified separately, against
		# a first version of this rule that anchored on a literal `?`. That is not an incomplete list, it
		# is the wrong instrument: the `query` filter substitutes the value of an EXACTLY NAMED parameter and
		# has no wildcard, so its reach is whatever a person remembered to write — and a person is the wrong
		# thing to depend on for a sink nobody can erase.
		#
		# Enumerating harder cannot repair it. The entry is written BEFORE the application validates
		# anything — a 401, a 404 and a 422 are logged like a 200 — so neither `SearchQuery::MAX_FILTERS` nor
		# `FilterQuery::MAX_IN_VALUES` bounds what can appear here.
		#
		# What is spent, stated plainly and not talked down: this log can no longer answer which FIELD or
		# OPERATOR a request filtered by. That is narrower than "a 2xx lives only here", which is false — the
		# `fingers_crossed` handler discards non-error records only on the channels it buffers (`observability`
		# and `deprecation` are excluded and always on), `AccessLogAuditListener` writes an `audit_log` row for
		# the successful `/api/*` requests its policy admits, and `SearchObservabilityListener` emits one
		# `keyset_search` line per successful search. What those keep is the route, the limit, the direction,
		# the pagination mode and the correlation id; none of them carries
		# the filter shape, and it deliberately did not gain it here. `filters[N][field]` is a caller's
		# string, and moving one into a stream with the same absence of rotation, TTL and erasure owner would
		# reproduce this defect one channel over to recover a diagnostic nobody had asked for. Doing it
		# safely means emitting the field the SERVER resolved, from the route's own field map, which is a
		# change to what the listener is given rather than a line here. Path, method, status and timing stay.
		#
		# The PATH is not covered and stays a separate, separately accepted residual:
		# `/api/v1/backoffice/users/<uuid>` names a person, and a filter over a URI cannot tell a path
		# segment from an identifier.
		format filter {
			request>uri regexp "(?i)([?]|%3f|%253f).*$" "?REDACTED"

			# The same log line also carries the referring document's URL, and for a same-origin API
			# request that document is the screen the ids live on — so `Referer` reproduces `actorId`
			# and `resourceId` in clear on the very entry whose `uri` the block above redacts. Caddy
			# logs request headers by default and censors only the credential-bearing ones, so nothing
			# above reaches this.
			#
			# Dropped whole rather than filtered parameter by parameter: the query filter above works on
			# a URI field and a header is not one, and the referring path on its own is worth less than
			# the standing risk that the next screen to put an id in its URL is not on anyone's list.
			request>headers>Referer delete
		}
	}

	root /app/api/public
	encode zstd br gzip

	mercure {
		# `SERVER_NAME` lists the public origin AND `php:80`, where the application publishes from inside the
		# network, so Caddy builds two servers from this block and two instances of this handler. Mercure 1.x
		# refuses a second unnamed hub, and the name is also what makes them ONE hub: the transport is pooled by
		# its configuration plus the name, so an update published on `php:80` reaches a subscriber on the origin.
		name erpify
		# Transport to use (default to Bolt)
		transport bolt {
			path /data/mercure.db
		}
		# Publisher JWT key
		publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
		# Subscriber JWT key
		subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
		# The embedded hub is dunglas/mercure 1.x, which refuses to start with the two keys above unless
		# compatibility mode is named. The application speaks the 0.x protocol (`protocol_version: '0.x'` in
		# api/config/packages/mercure.yaml): its tokens carry the `mercure` claim, its subscriber cookie is
		# `mercureAuthorization` and it subscribes with `?topic=`. Mode 8 is what keeps all three working, and
		# it validates such a token exactly as the 0.x hub did — no `aud`, no `exp` required. Leaving it means
		# moving the keys into an `issuer` block and the bundle to protocol 1.0 in the same change; either
		# half alone stops every publish and every private subscription.
		protocol_version_compatibility 8
		# Allow anonymous subscribers (double-check that it's what you want)
		anonymous
		# Enable the subscription API (double-check that it's what you want)
		subscriptions
		# Extra directives
		{$MERCURE_EXTRA_DIRECTIVES}
	}

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Add links to the API docs and to the Mercure Hub if not set explicitly (e.g. the PWA)
	header ?Link `</docs.jsonld>; rel="http://www.w3.org/ns/hydra/core#apiDocumentation", </.well-known/mercure>; rel="mercure"`
	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	# Symfony reads a JSON body whole through `php://input`, which `post_max_size` does not bound, so without
	# this an anonymous POST to the login route can drive a worker into `memory_limit` — a fatal that ends the
	# worker process, not just the request. The largest legitimate API payload is a few kilobytes; the bound is
	# scoped to the API so the Sentry tunnel and the hub keep their own sizes. A route that comes to accept
	# uploads raises it for its own path rather than here for everything.
	@apiBody path /api*
	request_body @apiBody {
		max_size 1MB
	}

	route {
		# Matches requests for HTML documents, for static files and for Next.js files,
		# except for known API paths and paths with extensions handled by the API / Symfony
		@pwa expression `(
				header({'Accept': '*text/html*'})
				&& !path(
					'/api*', '/.well-known/mercure*',
					'/docs*', '/graphql*', '/bundles*', '/contexts*', '/_profiler*', '/_wdt*', '/_dev*',
					'*.json*', '*.html', '*.csv', '*.yml', '*.yaml', '*.xml'
				)
			)
			|| path('/favicon.ico', '/manifest.json', '/robots.txt', '/sitemap*', '/_next*', '/__next*', '/monitoring*')
			|| query({'_rsc': '*'})`

		# Comment the following line if you don't want Next.js to catch requests for HTML documents.
		# In this case, they will be handled by the PHP app.
		reverse_proxy @pwa http://{$PWA_UPSTREAM}

		@phpRoute {
			not path /.well-known/mercure*
			not file {path}
		}
		rewrite @phpRoute index.php

		@frontController path index.php
		php @frontController {
			{$FRANKENPHP_SITE_CONFIG}
		}

		file_server {
			hide *.php
		}
	}
}
