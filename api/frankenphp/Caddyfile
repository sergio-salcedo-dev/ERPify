# Aligned with https://github.com/api-platform/api-platform/blob/main/api/frankenphp/Caddyfile
# Worker snippet: frankenphp/worker.Caddyfile (same layout as API Platform).
# @pwa also excludes /api* and /.well-known/mercure* for this monorepo.

{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}

		import worker.Caddyfile
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact secret- and identity-bearing query parameters. The access log has no owner of erasure:
		# no compose file declares a `logging:` driver, so stderr lands in the default json-file driver
		# with no rotation and no TTL, and nothing in the GDPR erasure path can reach it. Whatever gets
		# in outlives the erasure the app confirmed to the subject.
		#
		# Secrets: `authorization` can be set by Mercure, and `token` carries the single-use
		# invitation/reset secret (`<id>.<secret>`).
		#
		# Person ids arrive on two different requests and both have to be covered — closing only the
		# cheaper one leaves the sink open. The audit screen holds its filter state in the document URL
		# (`actorId`, `resourceId`), so those names appear on the navigation; the API request that the
		# same screen fires on every keystroke of the filter carries the identical values under the
		# generic `filters[N][value]` grammar, a key no name-based rule reaches. `correlationId` is not
		# a person id — it is redacted because a request-correlation UUID reconstructs a session.
		#
		# `filters[N][value]` is blunt on purpose: the grammar has no wildcard and the index carries no
		# type, so redacting the value axis also blanks level, actor type, action and the date bounds —
		# of every list surface, not just audit. The access log can no longer answer "which filter was
		# applied"; that diagnostic is spent knowingly. It buys more than audit: the account-holder name
		# and the user email filters travel the same way.
		#
		# The range 0..8 is the whole producer surface — nine axes is the most any criteria builder in
		# the PWA emits — and it is not left to a reader to keep true: the gate derives this range from
		# the file and fails when a builder outgrows it.
		format filter {
			request>uri query {
				replace authorization REDACTED
				replace token REDACTED
				replace actorId REDACTED
				replace resourceId REDACTED
				replace correlationId REDACTED
				replace filters[0][value] REDACTED
				replace filters[1][value] REDACTED
				replace filters[2][value] REDACTED
				replace filters[3][value] REDACTED
				replace filters[4][value] REDACTED
				replace filters[5][value] REDACTED
				replace filters[6][value] REDACTED
				replace filters[7][value] REDACTED
				replace filters[8][value] REDACTED
			}

			# The same log line also carries the referring document's URL, and for a same-origin API
			# request that document is the screen the ids live on — so `Referer` reproduces `actorId`
			# and `resourceId` in clear on the very entry whose `uri` the block above redacts. Caddy
			# logs request headers by default and censors only the credential-bearing ones, so nothing
			# above reaches this.
			#
			# Dropped whole rather than filtered parameter by parameter: the query filter above works on
			# a URI field and a header is not one, and the referring path on its own is worth less than
			# the standing risk that the next screen to put an id in its URL is not on anyone's list.
			request>headers>Referer delete
		}
	}

	root /app/api/public
	encode zstd br gzip

	mercure {
		# Transport to use (default to Bolt)
		transport bolt {
			path /data/mercure.db
		}
		# Publisher JWT key
		publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
		# Subscriber JWT key
		subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
		# Allow anonymous subscribers (double-check that it's what you want)
		anonymous
		# Enable the subscription API (double-check that it's what you want)
		subscriptions
		# Extra directives
		{$MERCURE_EXTRA_DIRECTIVES}
	}

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Add links to the API docs and to the Mercure Hub if not set explicitly (e.g. the PWA)
	header ?Link `</docs.jsonld>; rel="http://www.w3.org/ns/hydra/core#apiDocumentation", </.well-known/mercure>; rel="mercure"`
	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	route {
		# Matches requests for HTML documents, for static files and for Next.js files,
		# except for known API paths and paths with extensions handled by the API / Symfony
		@pwa expression `(
				header({'Accept': '*text/html*'})
				&& !path(
					'/api*', '/.well-known/mercure*',
					'/docs*', '/graphql*', '/bundles*', '/contexts*', '/_profiler*', '/_wdt*', '/_dev*',
					'*.json*', '*.html', '*.csv', '*.yml', '*.yaml', '*.xml'
				)
			)
			|| path('/favicon.ico', '/manifest.json', '/robots.txt', '/sitemap*', '/_next*', '/__next*', '/monitoring*')
			|| query({'_rsc': '*'})`

		# Comment the following line if you don't want Next.js to catch requests for HTML documents.
		# In this case, they will be handled by the PHP app.
		reverse_proxy @pwa http://{$PWA_UPSTREAM}

		@phpRoute {
			not path /.well-known/mercure*
			not file {path}
		}
		rewrite @phpRoute index.php

		@frontController path index.php
		php @frontController {
			{$FRANKENPHP_SITE_CONFIG}
		}

		file_server {
			hide *.php
		}
	}
}
