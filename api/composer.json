{
    "name":"erpify/api",
    "type":"project",
    "license":"proprietary",
    "description":"HTTP API, Symfony, FrankenPHP, PostgreSQL",
    "authors":[
        {
            "name":"Sergio Salcedo",
            "email":"sergio.sacedo.dev@gmail.com"
        }
    ],
    "minimum-stability":"stable",
    "prefer-stable":true,
    "require":{
        "php": "^8.5",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-xml": "*",
        "ext-zend-opcache": "*",
        "behat/gherkin": "^4.17.0",
        "doctrine/dbal": "^4.4.4",
        "doctrine/doctrine-bundle": "^3.2.4",
        "doctrine/doctrine-migrations-bundle": "^4.0.0",
        "doctrine/orm": "^3.6.7",
        "doctrine/persistence": "^4.2.0",
        "intervention/image": "^4.2.0",
        "league/flysystem": "^3.35.2",
        "league/flysystem-bundle": "^3.7.0",
        "nelmio/cors-bundle": "^2.6.1",
        "phpdocumentor/type-resolver": "^2.0.0",
        "phpstan/phpdoc-parser": "^2.3.3",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0.2",
        "sentry/sentry": "^4.29.0",
        "sentry/sentry-symfony": "^5.11.0",
        "softcreatr/jsonpath": "^1.0.2",
        "symfony/clock": "^8.0.8",
        "symfony/config": "^8.0.14",
        "symfony/console": "^8.0.14",
        "symfony/dependency-injection": "^8.0.14",
        "symfony/doctrine-bridge": "^8.0.14",
        "symfony/doctrine-messenger": "^8.0.14",
        "symfony/dotenv": "^8.0.14",
        "symfony/event-dispatcher": "^8.0.14",
        "symfony/flex": "^2.11.0",
        "symfony/framework-bundle": "^8.0.14",
        "symfony/http-foundation": "^8.0.14",
        "symfony/http-kernel": "^8.0.14",
        "symfony/intl": "8.0.*",
        "symfony/mailer": "^8.0.14",
        "symfony/mercure": "^0.7.2",
        "symfony/mercure-bundle": "^0.4.2",
        "symfony/messenger": "^8.0.14",
        "symfony/mime": "^8.0.13",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/password-hasher": "^8.0.8",
        "symfony/property-access": "^8.0.8",
        "symfony/property-info": "^8.0.8",
        "symfony/rate-limiter": "^8.0.14",
        "symfony/routing": "^8.0.13",
        "symfony/runtime": "^8.0.14",
        "symfony/scheduler": "^8.0.13",
        "symfony/security-bundle": "^8.0.14",
        "symfony/security-core": "^8.0.14",
        "symfony/serializer": "^8.0.14",
        "symfony/uid": "^8.0.9",
        "symfony/validator": "^8.0.14",
        "symfony/yaml": "^8.0.14"
    },
    "config":{
        "allow-plugins":{
            "php-http/discovery":true,
            "phpstan/extension-installer":true,
            "symfony/flex":true,
            "symfony/runtime":true
        },
        "bump-after-update":true,
        "sort-packages":true
    },
    "autoload":{
        "psr-4":{
            "Erpify\\":"src/"
        }
    },
    "autoload-dev":{
        "psr-4":{
            "Erpify\\Tests\\":"tests/"
        }
    },
    "replace":{
        "symfony/polyfill-ctype":"*",
        "symfony/polyfill-iconv":"*",
        "symfony/polyfill-php72":"*",
        "symfony/polyfill-php73":"*",
        "symfony/polyfill-php74":"*",
        "symfony/polyfill-php80":"*",
        "symfony/polyfill-php81":"*",
        "symfony/polyfill-php82":"*",
        "symfony/polyfill-php83":"*",
        "symfony/polyfill-php84":"*"
    },
    "scripts":{
        "auto-scripts":{
            "cache:clear":"symfony-cmd",
            "assets:install %PUBLIC_DIR%":"symfony-cmd"
        },
        "behat-tools-install":[
            "@composer install --working-dir=tools/behat --no-interaction"
        ],
        "post-install-cmd":[
            "@auto-scripts"
        ],
        "post-update-cmd":[
            "@auto-scripts"
        ]
    },
    "scripts-descriptions":{
        "behat-tools-install":"Install Behat and Mink into api/tools/behat (separate Composer tree; avoids Symfony 8 vs Behat 3 conflicts)"
    },
    "conflict":{
        "doctrine/doctrine-bundle":"3.2.5",
        "symfony/symfony":"*"
    },
    "extra":{
        "symfony":{
            "allow-contrib":true,
            "require":"8.0.*",
            "docker":true
        }
    },
    "require-dev":{
        "dantleech/gherkin-lint": "^0.2.4",
        "deptrac/deptrac": "^4.7.0",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.15",
        "guzzlehttp/psr7": "^2.13.0",
        "hautelook/alice-bundle": "^2.17.3",
        "icanhazstring/composer-unused": "^0.9.6",
        "justinrainbow/json-schema": "^6.10.0",
        "maglnet/composer-require-checker": "^4.24.0",
        "php-http/curl-client": "^2.4.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.5",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^13.2.4",
        "rector/rector": "^2.5.7",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^4.0.1",
        "symfony/browser-kit": "^8.0.14",
        "symfony/debug-bundle": "^8.0.8",
        "symfony/stopwatch": "^8.0.8",
        "symfony/web-profiler-bundle": "^8.0.14"
    }
}
