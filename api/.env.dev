###> symfony/framework-bundle ###
APP_SECRET=6b7b56845d9c3405cbbc070e16736b77
###< symfony/framework-bundle ###

XDEBUG_MODE=develop,debug

# Local dev (and the Playwright E2E suite that runs against this stack) hammers
# the API from a single client IP — page boots + RSC prefetches + the
# banks-real-api flows (bank seed + per-test navigation + cleanup deletes)
# routinely exceed the prod default of 120/min in the sliding window. Bump to
# 10000/min here so dev workflows and E2E suites are not gated by the limiter,
# while keeping the 429 contract itself exercised by PHPUnit/Behat through the
# 5/min override in .env.test.
RATE_LIMIT_ANONYMOUS_API_LIMIT=10000

# var-dumper server target for dump() output (make profiler.dump-server).
# Inline fallback when unset/not running; only read in dev (see config/packages/debug.yaml).
VAR_DUMPER_SERVER=127.0.0.1:9912
