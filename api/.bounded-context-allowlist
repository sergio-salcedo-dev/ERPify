# bounded-context isolation gate allowlist.
#
# The gate (tests/Unit/Shared/Architecture/BoundedContextGateTest.php) fails the
# build when a file in one business context imports another business context's
# `Domain\`, `Application\`, or `Infrastructure\` namespace — see the Level 1 rule
# in docs/rules/database.md#bounded-context-data-isolation-modular-monolith.
# `Erpify\Shared\…` is always importable (shared kernel) and never needs listing.
#
# Lines starting with `#` and blank lines are ignored. Three entry forms:
#
#   <relative/path.php>
#       Exempt the whole importer file. Coarse escape hatch — prefer a seam
#       entry so a *new* bad import in the same file is still caught.
#
#   <relative/path.php> => <Imported\Fqcn>
#       Exempt one specific (importer file, imported FQCN) seam. Preferred.
#
#   * => <Imported\Fqcn>
#       A globally published seam: a context's published Application service
#       interface or an integration-event class, importable from any context.
#
# Paths are POSIX, relative to api/, with no leading slash. Adding an entry is a
# deliberate, reviewable exception: the only legitimate reasons are a published
# cross-context seam (Application service interface / integration event) or a
# coupling explicitly justified in an ADR.

# Bank → BankAccount referential-integrity check. BankDeleter (Bank/Application)
# consumes the BankAccountRepository *interface* to block deleting a bank that
# still has accounts (clean 409 before the FK fires). Blessed by
# docs/adr/bank-bankaccount-modeling.md (inverse direction, "el patrón correcto").
src/Backoffice/Bank/Application/BankDeleter.php => Erpify\Backoffice\BankAccount\Domain\Repository\BankAccountRepository

# Bank · account-count read model. BankAccountCountEnricher (Bank/Application) is the SINGLE
# read-side seam that consumes BankAccountCounter — a read-only port defined in the BankAccount
# context — for the batched anti-N+1 GROUP-BY query. BankSearcher, BankDetailFinder and
# RefreshRealtimeOnBankChanged all compose their counts through it, so the cross-context surface is
# one import (not three) and a future switch to a denormalized bank.account_count localizes to that
# class. The Bank domain never queries bank_account directly (CE-3, CE-4). Pattern: cross-context
# read composition via a read-only port, same family as the referential-integrity check above.
src/Backoffice/Bank/Application/BankAccountCountEnricher.php => Erpify\Backoffice\BankAccount\Domain\Repository\BankAccountCounter

# BankAccount → Bank existence guard. BankAccountSearcher (BankAccount/Application)
# guards the parent bank's existence before listing its accounts via the published
# BankExistenceChecker port (UUID-shape → 400, existence → 404 before any account
# query) — the reusable cross-context existence seam documented in
# api/docs/adding-endpoints.md. The port's own contract throws BankNotFoundException,
# which the searcher propagates (and declares in its @throws), so the port and the
# exception it raises are exempted together as one published contract.
src/Backoffice/BankAccount/Application/BankAccountSearcher.php => Erpify\Backoffice\Bank\Domain\Repository\BankExistenceChecker
src/Backoffice/BankAccount/Application/BankAccountSearcher.php => Erpify\Backoffice\Bank\Domain\Exception\BankNotFoundException

# BankAccount → Bank existence guard (write side). BankAccountCreator (BankAccount/Application)
# guards the parent bank's existence before inserting an account via the same published
# BankExistenceChecker port the searcher uses (UUID-shape → 400, existence → 404 before the INSERT
# touches the FK). Same reusable cross-context existence seam, write direction.
src/Backoffice/BankAccount/Application/BankAccountCreator.php => Erpify\Backoffice\Bank\Domain\Repository\BankExistenceChecker

# BankAccount → Bank read-composition JOIN (ADR D3). DoctrineBankAccountCollectionSearchRepository
# (BankAccount/Infrastructure) composes each account row with its owning bank's identity
# (name/shortName) via a to-one DQL JOIN into a projection DTO — the read-composition pattern the ADR
# prescribes for "account + bank.name", not a runtime enricher. It imports the Bank *entity* (the JOIN
# target), a deeper read coupling than the port-based seams above, sanctioned by
# docs/adr/bank-bankaccount-modeling.md (D3).
src/Backoffice/BankAccount/Infrastructure/Persistence/Doctrine/DoctrineBankAccountCollectionSearchRepository.php => Erpify\Backoffice\Bank\Domain\Entity\Bank

# Membership → Organization single-org resolution. GrantMembership (Membership/Application) reads the
# installation's organization through the published OrganizationRepository port to resolve the org a new
# member belongs to — same intra-`Organization/` cross-module seam family as Bank ↔ BankAccount above.
src/Organization/Membership/Application/GrantMembership.php => Erpify\Organization\Organization\Domain\Repository\OrganizationRepository

# Iam bootstrap → Organization membership service. CreateInitialAdministratorCommand (Iam/Identity
# Infrastructure) creates the first admin identity and, atomically, its membership via the published
# GrantMembership use case — the single cross-context seam the bootstrap needs (password hashing and user
# creation stay local to Iam). The same recurring Iam → Organization direction invitation will reuse.
src/Iam/Identity/Infrastructure/Cli/CreateInitialAdministratorCommand.php => Erpify\Organization\Membership\Application\GrantMembership

# Session minting on login → two published seams. The LoginSuccessEvent listener (Iam/Identity
# Infrastructure) is the post-admission orchestrator: it mints the server-side session via the published
# StartSession use case (Iam/Session), failing closed with that context's SessionStoreUnavailable marker, and
# resolves the admission-time organization via the published FindUserOrganizationId read use case (Organization).
# It hands only primitives downstream, so Iam/Session stays unaware of SecurityUser and of Organization.
src/Iam/Identity/Infrastructure/Security/SessionMintingSuccessListener.php => Erpify\Iam\Session\Application\StartSession
src/Iam/Identity/Infrastructure/Security/SessionMintingSuccessListener.php => Erpify\Iam\Session\Domain\Exception\SessionStoreUnavailable
src/Iam/Identity/Infrastructure/Security/SessionMintingSuccessListener.php => Erpify\Organization\Membership\Application\FindUserOrganizationId

# Invitation flow → Identity + Organization seams (II-4). The onboarding orchestration is inherently
# cross-context: SendInvitation provisions an INVITED identity via the published InviteUser use case, funnels
# it through GrantMembership (so a user never exists without a membership), and mints the Invitation; on accept,
# AcceptInvitation loads and activates the identity through its UserRepository port + HashedPassword value
# object, reading its IdentityStatus to keep a SENT/non-INVITED desync opaque; the HTTP adapter hashes via the
# Identity PasswordHasher and re-authenticates through its UserProvider.
# Same recurring Iam → Identity/Organization direction that II-1/II-7 established — every entry is a published
# Application service, a domain port, or a shared value object, never a reach into internals.
src/Iam/Invitation/Application/AcceptInvitation.php => Erpify\Iam\Identity\Domain\Repository\UserRepository
src/Iam/Invitation/Application/AcceptInvitation.php => Erpify\Iam\Identity\Domain\HashedPassword
src/Iam/Invitation/Application/AcceptInvitation.php => Erpify\Iam\Identity\Domain\Enum\IdentityStatus
src/Iam/Invitation/Application/SendInvitation.php => Erpify\Iam\Identity\Application\InviteUser
src/Iam/Invitation/Application/SendInvitation.php => Erpify\Organization\Membership\Application\GrantMembership
src/Iam/Invitation/Application/ResendInvitation.php => Erpify\Iam\Identity\Domain\Repository\UserRepository
src/Iam/Invitation/Infrastructure/Http/AcceptInvitationController.php => Erpify\Iam\Identity\Domain\HashedPassword
src/Iam/Invitation/Infrastructure/Http/AcceptInvitationController.php => Erpify\Iam\Identity\Infrastructure\Security\PasswordHasher
src/Iam/Invitation/Infrastructure/Http/AcceptInvitationController.php => Erpify\Iam\Identity\Infrastructure\Security\UserProvider

# Password reset → revoke every session. RevokeSessionsBestEffort (Iam/Identity Application) consumes the
# published RevokeAllSessions use case (Iam/Session) to invalidate all of the user's sessions after a credential
# change — the "reset closes every session" guarantee — and swallows a store outage (defence-in-depth: the
# credential change already de-authenticates natively). CompletePasswordReset delegates to it, so this is the
# single seam. Same published-Application-service family as the session-minting orchestrator above, the reverse
# (teardown) direction the AllSessionsRevoked event's own docblock names as its consumer.
src/Iam/Identity/Application/RevokeSessionsBestEffort.php => Erpify\Iam\Session\Application\RevokeAllSessions

# GDPR erasure → hard-delete every session. FulfilIdentityErasure (Iam/Identity Application) consumes the
# published PurgeUserSessions use case (Iam/Session) to hard-delete the erased subject's sessions inside the same
# transaction, leaving no residual session PII. Distinct from the reset teardown above: that soft-revokes (keeps
# the row); erasure must drop the rows. Same published-Application-service family as the session-minting and
# reset seams — a use case, never a reach into Session internals.
src/Iam/Identity/Application/FulfilIdentityErasure.php => Erpify\Iam\Session\Application\PurgeUserSessions

# GDPR erasure → the two references with no physical foreign key. FulfilIdentityErasure (Iam/Identity
# Application) consumes the published PurgeUserMembership (Organization/Membership) and PurgeUserInvitations
# (Iam/Invitation) use cases to hard-delete, inside the same transaction, the membership that admitted the
# subject and every invitation addressed to them. Because those columns cross a context they are referenced by
# id with no FK, so deleting identity_user cascades to neither and the subject's real id would otherwise
# survive their own erasure. Same published-Application-service family as the session purge above, and the same
# recurring Iam → Organization direction the invitation seams already established: the context that owns the
# person orchestrates, and each owning context erases what it stores.
src/Iam/Identity/Application/FulfilIdentityErasure.php => Erpify\Organization\Membership\Application\PurgeUserMembership
src/Iam/Identity/Application/FulfilIdentityErasure.php => Erpify\Iam\Invitation\Application\PurgeUserInvitations
