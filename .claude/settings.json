{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|.*create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/adversarial-pass-check.sh --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/bmad-status-audit.sh --quiet-when-clean || true",
            "timeout": 15,
            "statusMessage": "Checking BMad sprint-status drift"
          },
          {
            "type": "command",
            "command": "scripts/worktree-collision-check.sh --quiet-when-clean || true",
            "timeout": 15,
            "statusMessage": "Checking for a worktree or branch collision"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mcp-server-dev@claude-plugins-official": true,
    "aikido@claude-plugins-official": true
  }
}
