# https://editorconfig.org — monorepo root (api/, pwa/, and repo tooling)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[api/**]
indent_size = 4

[Makefile]
indent_style = tab

# Makefile recipe lines require tabs but conditional/variable bodies use
# 2-space indents. editorconfig-checker can't distinguish, so leave the
# rule unset and let `make help` / Make itself enforce real syntax.
[**.mk]
indent_style = unset
indent_size = unset

[**.{yml,yaml}]
indent_size = 2

# Symfony YAMLs (services, routes, packages) use 4-space indentation by convention.
[api/**.{yml,yaml}]
indent_size = 4

# Symfony-docker upstream + Caddy configs are tab-indented; project shell
# scripts under scripts/ use spaces (4-wide). Keep both styles working.
[**/{Dockerfile,*.Caddyfile,Caddyfile}]
indent_style = tab
indent_size = 2

[api/{bin/sf,frankenphp/**/*.sh}]
indent_style = tab

[scripts/**/*.sh]
indent_style = space
indent_size = 4

[**.md]
indent_size = unset
indent_style = unset

# Behat features use 2-space indentation (Gherkin); editorconfig-checker
# expects multiples of 4 only when indent_size is left to default.
[api/features/**/*.feature]
indent_size = 2
