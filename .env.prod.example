# =============================================================================
# ERPify — production / staging environment template.
# =============================================================================
#
# Copy this file to `.env.prod.local` and fill in every CHANGE_ME value:
#
#     cp .env.prod.example .env.prod.local
#
# `.env.prod.local` is gitignored (matched by `.env.*.local`) — NEVER commit it.
# Compose reads these values via `--env-file .env.prod.local` (wired in
# make/config.mk for ENV=prod|staging). They feed `${VAR}` interpolation in
# compose.yaml / compose.prod.yaml — NOT a service's `env_file:`.
#
# The `make prod.env.check` guard refuses to start the stack while any
# required key below is empty or still holds a CHANGE_ME placeholder.
#
# VPS promotion: this same file deploys to a public VPS by swapping
# SERVER_NAME to a real domain and dropping CADDY_SERVER_EXTRA_DIRECTIVES
# (so Caddy switches from `tls internal` to automatic ACME). Nothing else
# changes.
# -----------------------------------------------------------------------------

# —— Required secrets (no weak fallback in prod — startup aborts if unset) ——
# Symfony application secret.            generate: openssl rand -hex 16
APP_SECRET=CHANGE_ME__openssl_rand_hex_16
# PostgreSQL password for POSTGRES_USER. generate: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME__openssl_rand_base64_24
# Mercure hub HMAC JWT key (publisher + subscriber).
#                                        generate: openssl rand -base64 48
CADDY_MERCURE_JWT_SECRET=CHANGE_ME__openssl_rand_base64_48

# —— Host / origins (swap SERVER_NAME to your domain on a VPS) ——
# Public server name Caddy serves and mints its internal cert for.
SERVER_NAME=erpify.local
# Base URL the PWA bakes in at build time (must match SERVER_NAME over https).
NEXT_PUBLIC_SYMFONY_API_BASE_URL=https://erpify.local

# —— Caddy TLS mode ——
# `tls internal` mints a cert from Caddy's own CA (no ACME) for a non-public
# name. On a public VPS, leave this EMPTY so Caddy uses automatic ACME.
CADDY_SERVER_EXTRA_DIRECTIVES=tls internal

# —— Optional overrides (sensible defaults exist in compose.yaml) ——
# POSTGRES_USER=erpify_user
# POSTGRES_DB=erpify_db
# Outbound mailer. Default `null://null` discards mail (fine for a test box).
# MAILER_DSN=null://null
# MAILER_FROM=noreply@erpify.local
# DEFAULT_NOTIFICATION_EMAIL=ops@erpify.local

# —— Optional: container resource limits (per-service ceilings) ——
# Defaults live in compose.prod.yaml; uncomment to tune for your host.
# PHP_CPU_LIMIT=2.0
# PHP_MEM_LIMIT=1g
# PWA_CPU_LIMIT=1.0
# PWA_MEM_LIMIT=512m
# DB_CPU_LIMIT=2.0
# DB_MEM_LIMIT=1g
# WORKER_CPU_LIMIT=1.0
# WORKER_MEM_LIMIT=512m
