# =============================================================================
# ERPify — production / staging environment template.
# =============================================================================
#
# Copy this file to `.env.prod.local` and fill in every CHANGE_ME value:
#
#     cp .env.prod.example .env.prod.local
#
# `.env.prod.local` is gitignored (matched by `.env.*.local`) — NEVER commit it.
# Compose reads these values via `--env-file .env.prod.local` (wired in
# make/config.mk for ENV=prod|staging). They feed `${VAR}` interpolation in
# compose.yaml / compose.prod.yaml — NOT a service's `env_file:`.
#
# The `make prod.env.check` guard refuses to start the stack while any
# required key below is empty or still holds a CHANGE_ME placeholder.
#
# VPS promotion: this same file deploys to a public VPS by swapping
# SERVER_NAME to a real domain and dropping CADDY_SERVER_EXTRA_DIRECTIVES
# (so Caddy switches from `tls internal` to automatic ACME). Nothing else
# changes.
# -----------------------------------------------------------------------------

# —— Required secrets (no weak fallback in prod — startup aborts if unset) ——
# Symfony application secret.            generate: openssl rand -hex 16
APP_SECRET=CHANGE_ME__openssl_rand_hex_16
# PostgreSQL password for POSTGRES_USER. generate: openssl rand -hex 24
# Use hex (not base64): this value is interpolated raw into DATABASE_URL, and
# base64's '/' '+' '=' corrupt the connection URL (MalformedDsnException).
POSTGRES_PASSWORD=CHANGE_ME__openssl_rand_hex_24
# Mercure hub HMAC JWT key (publisher + subscriber).
#                                        generate: openssl rand -base64 48
CADDY_MERCURE_JWT_SECRET=CHANGE_ME__openssl_rand_base64_48

# —— Required DB identity (no fallback in prod — startup aborts if unset) ——
# Not secret, but must be set explicitly: the prod DATABASE_URL uses ${VAR:?}
# for these (no silent erpify_user / erpify_db fallback). Keep or rename.
POSTGRES_USER=erpify_user
POSTGRES_DB=erpify_db

# —— Host / origins (swap SERVER_NAME to your domain on a VPS) ——
# Public server name Caddy serves and mints its internal cert for.
SERVER_NAME=erpify.local
# Base URL the PWA bakes in at build time (must match SERVER_NAME over https).
NEXT_PUBLIC_API_BASE_URL=https://erpify.local
# Browser-visible deployment env (dev | staging | prod). Set to `staging` on the
# staging host to enable client console diagnostics; `prod` keeps them silent.
NEXT_PUBLIC_APP_ENV=prod
# Sentry DSN for the erpify-pwa-prod project (Settings → Client Keys (DSN)).
# REQUIRED in prod — the pwa build aborts without it. Public by construction
# (the SDK runs client-side); events are routed through the same-origin
# /monitoring tunnel. The real secret (SENTRY_AUTH_TOKEN for source-map upload)
# is NOT used yet — see deferred-work.md.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.de.sentry.io/0

# —— Caddy TLS mode ——
# `tls internal` mints a cert from Caddy's own CA (no ACME) for a non-public
# name. On a public VPS, leave this EMPTY so Caddy uses automatic ACME.
CADDY_SERVER_EXTRA_DIRECTIVES=tls internal

# —— Mailer — REQUIRED in prod ——
# Both are `:?`-guarded in compose.prod.yaml and checked by `make prod.env.check`.
# They are required rather than defaulted because both defaults fail SILENTLY:
# `null://null` accepts security mail and drops it while reporting success (so a
# caller that records state on a confirmed send — the lockout notice stamps a 24h
# suppression window — records it for mail that was never transmitted), and the
# fallback sender sits at a reserved domain that can receive nothing. Security
# mail is partly unsolicited, so non-delivery produces no complaint to contradict
# either. MAILER_SECURITY_FROM must be a MONITORED, REPLYABLE mailbox: security
# emails tell the recipient to contact it, so no-reply@ is refused at send time.
MAILER_DSN=CHANGE_ME_smtp://user:pass@smtp.example.com:587
MAILER_SECURITY_FROM=CHANGE_ME_security@your-domain.tld

# —— Optional overrides (sensible defaults exist in compose.yaml) ——
# MAILER_FROM=noreply@erpify.local
# DEFAULT_NOTIFICATION_EMAIL=ops@erpify.local
# Seconds a remote SMTP server may hold a caller, connect and read alike. The default bounds both a
# password-reset request and the single-replica lockout-notice tick; raise it only for a slow relay.
# MAILER_SMTP_TIMEOUT=10

# —— Sentry (error + performance monitoring) — REQUIRED in prod ——
# `make prod.env.check` and the compose `:?` guards abort the deploy if either
# of the two below is missing — Sentry is on for prod (test machine + VPS).
# Provision the DSN via the Sentry MCP (.mcp.json); host-specific, keep it in
# this gitignored file, never committed. See docs/deployment-guide.md.
SENTRY_DSN=CHANGE_ME__sentry_dsn_from_mcp
# Performance tracing sample rate (0 = off; 0.2 recommended in prod).
SENTRY_TRACES_SAMPLE_RATE=0.2

# —— Optional: container resource limits (per-service ceilings) ——
# Defaults live in compose.prod.yaml; uncomment to tune for your host.
# PHP_CPU_LIMIT=2.0
# PHP_MEM_LIMIT=1g
# PWA_CPU_LIMIT=1.0
# PWA_MEM_LIMIT=512m
# DB_CPU_LIMIT=2.0
# DB_MEM_LIMIT=1g
# WORKER_CPU_LIMIT=1.0
# WORKER_MEM_LIMIT=512m
# scheduler_worker is a single-replica daily-tick consumer — tiny by design.
# SCHEDULER_CPU_LIMIT=0.25
# SCHEDULER_MEM_LIMIT=256m

# —— Optional: pinned internal IP for the database ——
# The db keeps a stable IP on the internal `backend` network so SSH-tunnelled
# GUI clients have a fixed target (see docs/vps-deployment.md). Still
# internal-only, no published port. Override only if 10.89.0.0/24 clashes with
# an existing network on the host (set both, IP within the subnet).
# DB_BACKEND_SUBNET=10.89.0.0/24
# DB_BACKEND_IP=10.89.0.10
