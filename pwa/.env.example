# --- Symfony API (ERPify) ---
# Browser: base URL for JSON (paths like /api/v1/health). Docker full stack: same origin as the page.
# Default image build uses https://localhost (see root compose.yaml build args).
NEXT_PUBLIC_API_BASE_URL="https://localhost"

# Deployment env surfaced to the browser (dev | staging | prod). Drives client
# telemetry verbosity: dev/staging log diagnostics to the console, prod is silent.
NEXT_PUBLIC_APP_ENV="dev"

# --- Client telemetry sink (Sentry) ---
# DSN for the Sentry project (erpify-pwa-dev locally; erpify-pwa-prod in prod).
# NOT a secret: it is a write-only, browser-embeddable identifier (the SDK runs
# client-side), so the NEXT_PUBLIC_ prefix — which inlines it into the public JS
# bundle — is correct and intended. It only permits SENDING events; abuse is
# bounded by allowed-domains + rate limits in the Sentry UI. Empty here keeps the
# SDK fully inert; set it in pwa/.env.local to watch your own errors in dev.
# Events are routed through the same-origin /monitoring tunnel, so the CSP
# `connect-src` stays untouched.
NEXT_PUBLIC_SENTRY_DSN=""
#
# Still server-only secrets / future work — never give these the NEXT_PUBLIC_ prefix:
#   - SENTRY_AUTH_TOKEN   (source-map upload at build/CI — deferred; prod traces
#                          are minified for now, see deferred-work.md)
#   - Datadog (a follow-up task): client token + DATADOG_API_KEY. Its
#     NEXT_PUBLIC_ name is deliberately NOT written here — the allowlist guard
#     (tests/next-public-env-allowlist.test.ts) scans this file's raw text and
#     would fail the build on any non-allowlisted prefixed name. It lands with
#     the Datadog adapter.

# Server-side only (SSR / RSC). Docker full stack (pwa container): http://php:80
# Local dev against API on host :8000: http://localhost:8000
SYMFONY_INTERNAL_URL="http://php:80"

# --- Playwright E2E (playwright.config.ts) ---
# Parallel workers. Leave unset or empty for Playwright default locally; CI uses 1 unless set.
# PW_WORKERS=4
# When using `webServer`, Symfony URLs below override pwa/.env.local for the dev server process:
# PLAYWRIGHT_NEXT_PUBLIC_API_BASE_URL="https://localhost"
# PLAYWRIGHT_SYMFONY_INTERNAL_URL="https://localhost"
