{
  "name": "erpify",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "dev": "next dev --turbo -p 80",
    "dev:e2e": "next dev --turbo -p 3000",
    "build": "next build",
    "start": "next start -p 80",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:graph": "depcruise src",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:reports": "playwright show-report reports",
    "clean": "rm -rf .next .next-e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@google/genai": "^2.15.0",
    "@hookform/resolvers": "^5.7.1",
    "@playwright/test": "^1.62.0",
    "@sentry/nextjs": "^10.70.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "inversify": "^8.2.3",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "react": "^19.2.6",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "reflect-metadata": "^0.2.2",
    "shadcn": "^4.17.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@next/eslint-plugin-next": "^16.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "eslint": "$eslint",
    "postcss": "$postcss",
    "@hono/node-server": "^2.0.5",
    "sharp": "^0.35.0"
  }
}
